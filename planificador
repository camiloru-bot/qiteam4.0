        else:
            st.success("🧱 Estructura semanal validada: ningún Long Run ocupa martes/jueves/sábado y el Long Run queda reservado al domingo según el nivel.")

        # Auditoría V4.0: no basta con que el rol sea correcto; cada día
        # debe pertenecer exactamente a la estructura del nivel.
        dias_esperados = [normalizar_dia_es(x["dia"]) for x in ESTRUCTURA_SEMANAL.get(nivel_atleta, [])]
        dias_generados = [normalizar_dia_es(x.get("Día")) for x in planeacion_modelo]
