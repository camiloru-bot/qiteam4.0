def nivel_num(nivel):
    return ORDEN_NIVEL.get(nivel, 2)


def catalogo_dataFrame():
    return pd.DataFrame([
        {
            "ID": s["ID"],
            "Categoría": s["Categoría"],
            "Título": s["Título"],
            "Objetivo": s["Objetivo"],
            "Nivel": s["Nivel"],
            "Meta": ", ".join(s["Meta"]),
            "Duración (h)": s["Duración (h)"],
            "TSS": s["TSS"],
            "Intensidad": s["Intensidad"],
            "Fase": s["Fase"],
            "Día Preferente": s["Día Preferente"],
            "Etiquetas": s["Etiquetas"]
        }
        for s in CATALOGO_MAESTRO
    ])


def fase_por_semanas(semanas):
    if semanas <= 3:
        return "Específica"
    if semanas <= 8:
        return "Desarrollo"
    return "Base"


def objetivos_por_foco(objetivo_semana):
    if objetivo_semana == "Desarrollo de VO2Max / Velocidad":
        return ["VO2Max", "Ritmo específico / VO2Max", "Velocidad / VO2Max"]
    if objetivo_semana == "Umbral / Sostenido":
        return ["Umbral / Sostenido", "Resistencia aeróbica / Umbral"]
    if objetivo_semana == "Recuperación / Regenerativo":
        return ["Recuperación"]
    return [
        "Base aeróbica",
        "Variabilidad de ritmo",
        "Resistencia aeróbica",
        "Resistencia aeróbica / incremento de volumen"
    ]


def seleccionar_sesiones(nivel, meta, objetivo_semana, semanas_faltantes):
    fase_preferida = fase_por_semanas(semanas_faltantes)
    objetivos = objetivos_por_foco(objetivo_semana)
    nivel_atleta = nivel_num(nivel)
    candidatos = []

    for sesion in CATALOGO_MAESTRO:
        if meta not in sesion["Meta"]:
            continue

        if nivel_num(sesion["Nivel"]) > nivel_atleta:
            continue

        score = 0
        if sesion["Objetivo"] in objetivos:
            score += 50
        if sesion["Fase"] == fase_preferida:
            score += 20
        if sesion["Nivel"] == nivel:
            score += 15
        if sesion["Día Preferente"]:
            score += 5

        candidatos.append((score, sesion))

    candidatos.sort(key=lambda x: x[0], reverse=True)
    return [x[1] for x in candidatos]


def asignar_dias_sin_duplicados(plan):
    """Asigna los días estructurales del catálogo sin intercambiar sesiones.

    Regla V3.6: cuando una categoría tiene un día estructural definido, ese
    día tiene prioridad absoluta. Esto evita que un Long Run termine en
    martes y que el Tempo termine el domingo solo porque el orden de las
    propuestas cambió. El fallback solo se usa para categorías sin día
    estructural o ante una colisión real.
    """
    usados = set()
    plan_asignado = []

    # Primero intentamos respetar el día estructural de cada categoría.
    # Ordenamos por prioridad para que Long Run tenga siempre su domingo.
    prioridad_dia = {
        "Qi Long Run": 100, "Long Run": 100,
        "Qi Intervalos": 90, "Intervalos": 90,
        "Qi Tempo": 80, "Tempo": 80,
        "Recuperación": 70, "Regenerativo": 70,
        "Qi Fartlek": 60, "Fartlek": 60,
    }

    sesiones_ordenadas = sorted(
        plan,
        key=lambda s: prioridad_dia.get(
            s.get("Categoría", s.get("Tipo de Sesión", "")), 50
        ),
        reverse=True,
    )

    pendientes = []
    for sesion in sesiones_ordenadas:
        categoria = sesion.get("Categoría", sesion.get("Tipo de Sesión", ""))
        dia_estructural = normalizar_dia_es(DIAS_CATEGORIA.get(categoria))

        if dia_estructural and dia_estructural not in usados:
            dia_asignado = dia_estructural
        else:
            # Solo aquí usamos el día preferente del registro.
            preferido = normalizar_dia_es(sesion.get("Día"))
            candidatos = []
            for dia in (preferido, dia_estructural, *DIAS_ES):
                dia = normalizar_dia_es(dia)
                if dia and dia not in candidatos:
                    candidatos.append(dia)
            dia_asignado = next(
                (dia for dia in candidatos if dia not in usados),
                None
            )

        if dia_asignado is None:
            pendientes.append(sesion)
            continue

        sesion_nueva = dict(sesion)
        sesion_nueva["Día"] = dia_asignado
        usados.add(dia_asignado)
        plan_asignado.append(sesion_nueva)

    # Si hubiera más sesiones que días disponibles, se mantiene el fallback
    # sin romper la aplicación. En la planificación normal no debería ocurrir.
    for sesion in pendientes:
        dia_asignado = next((d for d in DIAS_ES if d not in usados), DIAS_ES[-1])
        sesion_nueva = dict(sesion)
        sesion_nueva["Día"] = dia_asignado
        usados.add(dia_asignado)
        plan_asignado.append(sesion_nueva)

    plan_asignado.sort(key=lambda s: DIAS_ES.index(s["Día"]))
    return plan_asignado


