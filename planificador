        st.info(
            f"🧠 Frecuencia objetivo para nivel {nivel_atleta}: "
            f"**{frecuencia_objetivo} sesiones de corrida/semana**. "
            f"El Catálogo Maestro propone {len(planeacion_modelo)} sesión(es), "
            "priorizando Long Run y estímulos estructurales."
        )
        st.markdown("#### 🧱 Estructura semanal del atleta")
        estructura_ui = ESTRUCTURA_SEMANAL.get(nivel_atleta, ESTRUCTURA_SEMANAL["Medio"])
        for slot in estructura_ui:
