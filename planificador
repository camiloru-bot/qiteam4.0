            st.write(
                f"• **{slot['dia']}** — {marca}{slot['etiqueta']}"
            )
        fuerza_ui = ", ".join(DIAS_FUERZA_POR_NIVEL.get(nivel_atleta, []))
        st.caption(f"🏋️ Fortalecimiento estructural: {fuerza_ui}. El sábado no se fuerza Fartlek; el Catálogo llena el rol definido por la estructura.")

        tss_teorico_semana = sum(
            s["TSS Estimado"] for s in planeacion_modelo
        )
        horas_teoricas_semana = sum(
            s["Horas Estimadas"] for s in planeacion_modelo
        )

        dias_plan = [normalizar_dia_es(s.get("Día")) for s in planeacion_modelo]
        duplicados_dias = sorted({
            dia for dia in dias_plan if dias_plan.count(dia) > 1
        })
        if duplicados_dias:
            st.error(
                "🚨 El plan contiene días duplicados: "
                + ", ".join(duplicados_dias)
            )
        else:
            st.success(
                f"✅ Calendario validado: {len(planeacion_modelo)} sesión(es) "
                "en días distintos."
            )

        if "WorkoutDay" in df.columns:
            try:
                df["WorkoutDay_dt"] = pd.to_datetime(
                    df["WorkoutDay"], errors="coerce"
                )
                max_fecha = df["WorkoutDay_dt"].max()
                min_fecha_reciente = max_fecha - pd.Timedelta(days=7)
                df_semana_pasada = df[
                    df["WorkoutDay_dt"] >= min_fecha_reciente
                ].copy()
            except Exception:
                df_semana_pasada = df.head(7)
        else:
            df_semana_pasada = df.head(7)

        tss_real_semana = (
            df_semana_pasada["TSS"].sum()
            if "TSS" in df_semana_pasada.columns else 0
        )
        horas_real_semana = (
            df_semana_pasada["TimeTotalInHours"].sum()
            if "TimeTotalInHours" in df_semana_pasada.columns else 0
        )
        sesiones_semana = len(df_semana_pasada)

        diff_horas = horas_real_semana - horas_teoricas_semana
        diff_tss = tss_real_semana - tss_teorico_semana

        if abs(diff_horas) <= 0.25:
            semaforo_tiempo = "🟢 **Óptimo**"
            comentario_tiempo = "El volumen de tiempo estuvo dentro de un rango razonable."
        elif horas_real_semana < horas_teoricas_semana:
            semaforo_tiempo = "🟡 **Por debajo de lo esperado**"
            comentario_tiempo = "El volumen ejecutado quedó por debajo de la referencia."
        else:
            semaforo_tiempo = "🔴 **Por encima de lo esperado**"
            comentario_tiempo = "El volumen ejecutado superó la referencia."

        if abs(diff_tss) <= 12:
            semaforo_tss = "🟢 **Carga equilibrada**"
            comentario_tss = "El TSS estuvo dentro del margen de referencia."
        elif tss_real_semana < tss_teorico_semana:
            semaforo_tss = "🟡 **Carga inferior**"
            comentario_tss = "El estrés acumulado quedó por debajo de la referencia."
        else:
            semaforo_tss = "🔴 **Carga superior**"
            comentario_tss = "El estrés acumulado superó la referencia."

        col1, col2 = st.columns(2)
        with col1:
            st.markdown("### ⏱️ Control de Tiempo")
            st.markdown(f"**Referencia:** {horas_teoricas_semana:.2f} hrs")
            st.markdown(f"**Ejecutado:** {horas_real_semana:.2f} hrs")
            st.markdown(f"**Estado:** {semaforo_tiempo}")
            st.info(comentario_tiempo)

        with col2:
            st.markdown("### ⚡ Control de TSS")
            st.markdown(f"**Referencia:** {tss_teorico_semana:.1f}")
            st.markdown(f"**Ejecutado:** {tss_real_semana:.1f}")
            st.markdown(f"**Estado:** {semaforo_tss}")
            st.info(comentario_tss)

        # ====================================================
        # SISTEMA RECOMIENDA
        # ====================================================

        st.markdown("---")
        st.subheader("🧠 El Sistema Recomienda")

        resultado_recomendacion = generar_recomendacion(
            tss_real_semana,
            tss_teorico_semana,
            horas_real_semana,
            horas_teoricas_semana,
            sesiones_semana,
            nivel_atleta,
            diferencia_semana
        )

        st.info(resultado_recomendacion["general"])

        st.markdown("#### 🔎 Factores detectados")
        for recomendacion in resultado_recomendacion["recomendaciones"]:
            st.write(f"• {recomendacion}")

        if resultado_recomendacion["alertas"]:
            st.markdown("#### ⚠️ Alertas")
            for alerta in resultado_recomendacion["alertas"]:
                st.warning(alerta)

        # ====================================================
        # FECHAS DE LA PRÓXIMA SEMANA
        # ====================================================

        st.markdown("---")
        st.subheader("📅 Semana concreta de planificación")

        # La semana propuesta comienza el lunes siguiente a la fecha actual.
        # El entrenador puede cambiar el lunes de referencia.
        lunes_defecto = fecha_lunes_siguiente(hoy)
        lunes_plan = st.date_input(
            "Lunes de la semana que vamos a construir",
            value=lunes_defecto,
            key=f"lunes_plan_{atleta_seleccionado}"
        )

        mapa_fechas = fechas_plan_semana(lunes_plan)

        st.caption(
            f"Semana: {lunes_plan.strftime('%d/%m/%Y')} → "
            f"{mapa_fechas['Domingo'].strftime('%d/%m/%Y')}"
        )

        # ====================================================
        # REVISIÓN DE PROPUESTAS + ENTRENADOR DECIDE
        # ====================================================

        st.markdown("---")
        st.subheader("📚 Sesiones propuestas por el Catálogo Maestro")
        st.caption(
            "Aquí se revisa cada propuesta individualmente. "
            "Una modificación o rechazo puede generar una nueva sugerencia. Un rechazo se convierte además en una restricción activa para ese espacio."
            "La frecuencia semanal objetivo se controla automáticamente. "
            "V4.0: el día y el rol son estructurales y no pueden cambiar por una sugerencia."
        )

        decisiones_sesiones = perfil.get("decisiones_sesiones", {})

        plan_final = []
        sesiones_revisadas = 0
        sesiones_aprobadas = 0
        sesiones_pendientes = 0

        for indice, sesion in enumerate(planeacion_modelo):
            fecha = fecha_sesion(sesion, lunes_plan)
            rol_esperado = rol_estructural_para_dia(
                nivel_atleta, nombre_dia_es(fecha)
            )
            key_base = clave_espacio(fecha, rol_esperado or rol_estructural(sesion))

            registro = decisiones_sesiones.get(key_base, {})
            sesion_persistida = registro.get("sesion_actual")

            # V4.0: una decisión persistida solo puede entrar si pertenece al
            # mismo espacio estructural. Esto elimina el problema histórico de
            # un Long Run guardado en martes que reaparece aunque el catálogo
            # ya haya sido corregido.
            if (
                isinstance(sesion_persistida, dict)
                and rol_estructural(sesion_persistida) == rol_esperado
                and normalizar_dia_es(sesion_persistida.get("Día")) == nombre_dia_es(fecha)
            ):
                sesion_actual = preparar_sesion(
                    sesion_persistida,
                    nombre_dia_es(fecha),
                    rol_esperado,
                    sesion.get("Doble Jornada", False)
                )
            else:
                sesion_actual = preparar_sesion(
                    sesion,
                    nombre_dia_es(fecha),
                    rol_esperado or rol_estructural(sesion),
                    sesion.get("Doble Jornada", False)
                )
                # No heredamos estado/observación de una sesión incompatible.
                if sesion_persistida:
                    registro = {}

            estado = registro.get("estado", "Pendiente")
            observacion_guardada = registro.get("observacion", "")
            historial_sugerencias = registro.get("historial_sugerencias", [])

            # V3.9: restricciones de la semana derivadas de rechazos previos.
            restricciones_semana = restricciones_rechazo_semana(
                decisiones_sesiones,
                lunes_plan,
                nivel_atleta
            )

            dia_actual_es = nombre_dia_es(fecha)
            restriccion_dia = restricciones_semana.get(
                dia_actual_es,
                {}
            )

            tss_actual = float(sesion_actual.get("TSS", sesion_actual.get("TSS Estimado", 0)))
            duracion_actual = float(sesion_actual.get("Duración (h)", sesion_actual.get("Horas Estimadas", 0)))
            categoria_actual = sesion_actual.get("Categoría", sesion_actual.get("Tipo de Sesión", ""))
            objetivo_actual = sesion_actual.get("Objetivo", "")
            nivel_actual = sesion_actual.get("Nivel", nivel_atleta)
            estructura_actual = sesion_actual.get(
                "Estructura TP",
                sesion_actual.get("Estructura Detallada para TP", sesion_actual.get("Estructura Breve", ""))
            )

            titulo_tarjeta = (
                f"📌 {nombre_dia_es(fecha)} {fecha.strftime('%d/%m/%Y')} — "
                f"{sesion_actual['ID']} — {sesion_actual['Título']} "
                f"(TSS {tss_actual:.1f})"
            )

            with st.expander(titulo_tarjeta, expanded=(indice == 0)):
                st.write(f"**Categoría:** {categoria_actual}")
                st.write(f"**Objetivo:** {objetivo_actual}")
                st.write(f"**Nivel:** {nivel_actual}")
                if sesion_actual.get("Doble Jornada"):
                    st.info("🔁 Miércoles: carrera AM + fortalecimiento PM")
                st.write(
                    f"**Duración:** {duracion_actual:.2f} h | "
                    f"**TSS:** {tss_actual:.1f}"
                )

                st.code(estructura_actual, language="text")

                opciones_decision = [
                    "Pendiente",
                    "Aprobar",
                    "Modificar",
                    "Rechazar"
                ]

                decision = st.selectbox(
                    "👨‍🏫 Decisión para esta sesión",
                    opciones_decision,
                    index=(
                        opciones_decision.index(estado)
                        if estado in opciones_decision else 0
                    ),
                    key=f"decision_sesion_{atleta_seleccionado}_{key_base}"
                )

                observacion = st.text_area(
                    "📝 Observación del entrenador",
                    value=observacion_guardada,
                    placeholder=(
                        "Ej.: Necesitamos un poco más de carga, "
                        "una hora 30 minutos sería insuficiente."
                    ),
                    key=f"obs_sesion_{atleta_seleccionado}_{key_base}"
                )

                c_a, c_b = st.columns(2)

                with c_a:
                    guardar_sesion = st.button(
                        "💾 Guardar decisión de esta sesión",
                        key=f"save_session_{atleta_seleccionado}_{key_base}"
                    )

                with c_b:
                    nueva_sugerencia_btn = st.button(
                        "🔄 Generar nueva sugerencia",
                        key=f"new_suggestion_{atleta_seleccionado}_{key_base}"
                    )

                if guardar_sesion:
                    registro["estado"] = decision
                    registro["observacion"] = observacion
                    registro["sesion_actual"] = sesion_actual
                    registro["fecha"] = fecha.strftime("%Y-%m-%d")
                    registro["historial_sugerencias"] = historial_sugerencias

                    if decision == "Rechazar":
                        registro["restriccion_rechazo"] = {
                            "ID": sesion_actual.get("ID"),
                            "Categoría": sesion_actual.get(
                                "Categoría",
                                sesion_actual.get(
                                    "Tipo de Sesión", ""
                                )
                            ),
                            "Rol Estructural": rol_estructural(
                                sesion_actual
                            ),
                            "Fecha": fecha.strftime("%Y-%m-%d"),
                            "Motivo": observacion
                        }
                    elif decision == "Aprobar":
                        registro["decision_final"] = True
                    else:
                        registro["decision_final"] = False

                    decisiones_sesiones[key_base] = registro
                    st.session_state["atletas_db"][atleta_seleccionado][
                        "decisiones_sesiones"
                    ] = decisiones_sesiones
                    guardar_db(st.session_state["atletas_db"])

                    st.success(
                        f"✅ Decisión '{decision}' guardada para "
                        f"{fecha.strftime('%d/%m/%Y')}."
                    )
                    st.rerun()

                if nueva_sugerencia_btn:
                    es_rechazo = decision == "Rechazar"

                    # Si se rechaza, la siguiente propuesta debe respetar
                    # el rol estructural del día y no repetir el rol/categoría
                    # rechazados. Esto evita, por ejemplo, que un Long Run
                    # rechazado el martes vuelva a aparecer el martes.
                    if es_rechazo:
                        rol_siguiente = (
                            rol_estructural_para_dia(
                                nivel_atleta,
                                nombre_dia_es(fecha)
                            )
                            or rol_estructural(sesion_actual)
                        )
                        roles_bloqueados = {
                            rol_estructural(sesion_actual)
                        }
                        categorias_bloqueadas = {
                            sesion_actual.get(
                                "Categoría",
                                sesion_actual.get(
                                    "Tipo de Sesión", ""
                                )
                            )
                        }
                    else:
                        rol_siguiente = (
                            restriccion_dia.get(
                                "rol_estructural"
                            )
                            or rol_estructural(sesion_actual)
                        )
                        roles_bloqueados = set(
                            restriccion_dia.get("roles", set())
                        )
                        categorias_bloqueadas = set(
                            restriccion_dia.get("categorias", set())
                        )

                    # Solo excluimos las sesiones que pertenecen al historial
                    # de este mismo espacio y que realmente fueron descartadas.
                    # La prioridad es tener una alternativa estructural válida.
                    ids_historial = [
                        x.get("ID")
                        for x in historial_sugerencias
                        if x.get("ID")
                    ]

                    nueva = buscar_nueva_sugerencia(
                        sesion_actual=sesion_actual,
                        nivel=nivel_atleta,
                        meta=meta_input,
                        objetivo_semana=objetivo_semana,
                        semanas_faltantes=diferencia_semana,
                        feedback=observacion,
                        ids_excluidos=ids_historial,
                        dia_objetivo=nombre_dia_es(fecha),
                        rol_objetivo=rol_siguiente,
                        roles_excluidos=roles_bloqueados,
                        categorias_excluidas=categorias_bloqueadas
                    )

                    if nueva is None:
                        st.warning(
                            f"⚠️ No se encontró otra sesión compatible para **{nombre_dia_es(fecha)} / {rol_siguiente}**. "
                            "La estructura del atleta se mantiene intacta; puedes ampliar el Catálogo Maestro o modificar manualmente."
                        )
                    else:
                        historial_sugerencias.append({
                            "ID": sesion_actual["ID"],
                            "Título": sesion_actual["Título"],
                            "fecha_sugerencia": datetime.now().strftime(
                                "%Y-%m-%d %H:%M:%S"
                            ),
                            "motivo": observacion
                        })

                        registro["sesion_actual"] = nueva
                        registro["estado"] = "Pendiente"
                        registro["observacion"] = observacion
                        registro["fecha"] = fecha.strftime("%Y-%m-%d")
                        registro["historial_sugerencias"] = historial_sugerencias
                        decisiones_sesiones[key_base] = registro

                        st.session_state["atletas_db"][atleta_seleccionado][
                            "decisiones_sesiones"
                        ] = decisiones_sesiones
                        guardar_db(st.session_state["atletas_db"])

                        st.success(
                            f"🔄 Nueva sugerencia generada: "
                            f"{nueva['ID']} — {nueva['Título']}"
                        )
                        st.rerun()

                if historial_sugerencias:
                    st.markdown("#### 🔄 Historial de esta propuesta")
                    hist_df = pd.DataFrame(historial_sugerencias)
                    st.dataframe(
                        hist_df,
                        use_container_width=True,
                        hide_index=True
                    )

                if estado == "Aprobar":
                    st.success("✅ Sesión aprobada por el entrenador.")
                    sesiones_aprobadas += 1
                    plan_final.append({
                        **sesion_actual,
                        "Fecha": fecha
                    })
                elif estado == "Pendiente":
                    st.info("🟡 Pendiente de decisión del entrenador.")
                    sesiones_pendientes += 1
                    plan_final.append({
                        **sesion_actual,
                        "Fecha": fecha
                    })
                else:
                    st.warning(
                        f"📝 Sesión marcada como: **{estado}**. "
                        "Todavía no forma parte de un plan final aprobado."
                    )

                sesiones_revisadas += 1

        # ====================================================
        # ENTRENADOR DECIDE — RESUMEN
        # ====================================================

        st.markdown("---")
        st.subheader("👨‍🏫 Entrenador Decide")

        st.markdown(
            """
**El sistema propone. El entrenador decide.**

Una modificación o rechazo **no cambia silenciosamente la sesión**:
genera una nueva propuesta que vuelve a quedar pendiente de aprobación.
"""
        )

        st.metric(
            "Sesiones aprobadas",
            f"{sesiones_aprobadas}/{sesiones_revisadas}"
        )

        if sesiones_pendientes:
            st.info(
                f"🟡 Hay {sesiones_pendientes} sesión(es) pendientes "
                "de decisión."
            )

        # Decisión general histórica, conservada de V3.2.
        decisiones_disponibles = [
            "Mantener planificación",
            "Aumentar carga",
            "Reducir carga",
            "Recuperación / descarga",
            "Modificar sesión específica",
            "Otra decisión"
        ]

        decision_general = st.radio(
            "Decisión general de la semana:",
            decisiones_disponibles,
            key=f"decision_general_{atleta_seleccionado}"
        )

        comentario_general = st.text_area(
            "📝 Justificación general del entrenador",
            placeholder=(
                "Observaciones sobre la semana, fatiga, cumplimiento, "
                "contexto externo o criterio de planificación."
            ),
            key=f"comentario_general_{atleta_seleccionado}"
        )

        if st.button(
            "💾 Guardar decisión general del entrenador",
            key=f"guardar_decision_general_{atleta_seleccionado}"
        ):
            fecha_registro = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            nueva_decision = {
                "fecha": fecha_registro,
                "version_app": VERSION_APP,
                "semana_plan": (
                    f"{lunes_plan.strftime('%Y-%m-%d')} → "
                    f"{mapa_fechas['Domingo'].strftime('%Y-%m-%d')}"
                ),
                "tss_planificado": float(tss_teorico_semana),
                "tss_ejecutado": float(tss_real_semana),
                "horas_planificadas": float(horas_teoricas_semana),
                "horas_ejecutadas": float(horas_real_semana),
                "recomendacion_sistema": resultado_recomendacion[
                    "decision_sugerida"
                ],
                "decision_entrenador": decision_general,
                "comentario_entrenador": comentario_general,
                "sesiones_catalogo_propuestas": [
                    s["ID"] for s in planeacion_modelo
                ],
                "sesiones_aprobadas": [
                    s["ID"] for s in plan_final
                    if decisiones_sesiones.get(
                        clave_sesion(s["Fecha"], s["ID"]), {}
                    ).get("estado") == "Aprobar"
                ]
            }

            decisiones = perfil.get("decisiones_entrenador", [])
            decisiones.append(nueva_decision)

            st.session_state["atletas_db"][atleta_seleccionado][
                "decisiones_entrenador"
            ] = decisiones

            guardar_db(st.session_state["atletas_db"])

            st.success("✅ Decisión general guardada correctamente.")

        # ====================================================
        # PLANEACIÓN FINAL / SUGERIDA
        # ====================================================

        st.markdown("---")
        st.subheader("📅 Planeación de la Próxima Semana")

        st.caption(
            f"Atleta: {atleta_seleccionado} | "
            f"Nivel: {nivel_atleta} | Meta: {meta_input} | "
            f"{diferencia_semana} semanas restantes"
        )

        if plan_final:
            plan_final = sorted(plan_final, key=lambda s: s["Fecha"])
            tabla_plan = []

            for s in plan_final:
                estado_s = decisiones_sesiones.get(
                    clave_sesion(s["Fecha"], s["ID"]), {}
                ).get("estado", "Pendiente")

                tabla_plan.append({
                    "Fecha": s["Fecha"].strftime("%d/%m/%Y"),
                    "Día": nombre_dia_es(s["Fecha"]),
                    "ID": s["ID"],
                    "Sesión": s["Título"],
                    "Categoría": s["Categoría"],
                    "Duración (h)": s["Duración (h)"],
                    "TSS": s["TSS"],
                    "Estado entrenador": estado_s
                })

            st.dataframe(
                pd.DataFrame(tabla_plan),
                use_container_width=True,
                hide_index=True
            )

            if sesiones_pendientes:
                st.warning(
                    "⚠️ Esta planificación todavía contiene sesiones "
                    "pendientes. No debe interpretarse como plan final aprobado."
                )
            elif sesiones_aprobadas == sesiones_revisadas:
                st.success(
                    "✅ Todas las sesiones de esta semana fueron aprobadas "
                    "por el entrenador."
                )

        # ====================================================
        # HISTORIAL DE DECISIONES
        # ====================================================

        decisiones_historial = perfil.get("decisiones_entrenador", [])

        if decisiones_historial:
            st.markdown("---")
            st.subheader("📚 Historial de Decisiones del Entrenador")

            historial_df = pd.DataFrame(decisiones_historial)
            columnas_historial = [
                "fecha", "version_app", "semana_plan",
                "tss_planificado", "tss_ejecutado",
                "horas_planificadas", "horas_ejecutadas",
                "recomendacion_sistema", "decision_entrenador",
                "comentario_entrenador", "sesiones_catalogo_propuestas",
                "sesiones_aprobadas"
            ]

            columnas_disponibles = [
                c for c in columnas_historial if c in historial_df.columns
            ]

            st.dataframe(
                historial_df[columnas_disponibles],
                use_container_width=True,
                hide_index=True
            )

        # ====================================================
        # HISTORIAL COMPLETO
        # ====================================================

        st.markdown("---")
        st.subheader(
            f"📋 Historial Completo de Sesiones Ejecutadas: "
            f"{atleta_seleccionado}"
        )

        if perfil.get("archivos_cargados"):
            st.caption(
                "Archivos integrados: " +
                ", ".join(perfil["archivos_cargados"])
            )

        display_cols = [
            "WorkoutDay",
            "Title",
            "WorkoutType",
            "TimeTotalInHours",
            "HeartRateAverage",
            "TSS"
        ]

        available_cols = [c for c in display_cols if c in df.columns]

        if "WorkoutDay" in df.columns:
            try:
                df["WorkoutDay_dt"] = pd.to_datetime(
                    df["WorkoutDay"], errors="coerce"
                )
                df = (
                    df.sort_values(
                        by="WorkoutDay_dt",
                        ascending=False
                    )
                    .drop(columns=["WorkoutDay_dt"])
                )
            except Exception:
                pass

        if available_cols:
            st.dataframe(
                df[available_cols],
                use_container_width=True,
                hide_index=True
            )

        # ====================================================
        # TEMPORADA
        # ====================================================

        st.markdown("---")
        st.subheader("🎯 Planificación Estratégica según la Temporada")

        if diferencia_semana > 8:
            st.info(
                f"🟢 **Fase Base / Desarrollo ({diferencia_semana} semanas):** "
                "Acumulación de volumen aeróbico estable."
            )
        elif diferencia_semana >= 3:
            st.warning(
                f"🟡 **Fase Específica ({diferencia_semana} semanas):** "
                f"Elevar especificidad hacia {meta_input}."
            )
        else:
            st.error(
                f"🔴 **Tapering / Descarga ({diferencia_semana} semanas):** "
                "Reducir volumen y priorizar asimilación."
            )

    else:
        st.info(
            f"👈 Sube el primer archivo CSV semanal en la barra lateral "
            f"para **{atleta_seleccionado}** y comenzar a construir su historial."
        )

# ============================================================
# PIE DE PÁGINA
# ============================================================

st.markdown("---")
st.caption(
    f"Qi Team | {VERSION_APP} — {NOMBRE_VERSION} | "
    "🧠 Sistema recomienda → 📚 Catálogo Maestro → "
    "👨‍🏫 Entrenador decide → 🔄 Nueva sugerencia → 💾 Registro"
)
